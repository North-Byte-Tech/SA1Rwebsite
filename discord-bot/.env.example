# Verbose console logging (role sync decisions, command invocations, log
# server activity). Off by default, restart to change -
# matches the Lua side's sfos_debug convention.
DEBUG=false

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional - leave blank to skip the game audit log feature. Website
# recruitment notifications are sent as direct messages and don't require
# this channel.
DISCORD_LOG_CHANNEL_ID=

# Public recruitment Discord link shown on the site. The main community
# Discord invite should stay private and only be sent after a successful
# final acceptance.
DISCORD_MAIN_INVITE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sfos
DB_PASSWORD=
DB_NAME=sfos

# Must match sfos_discord_sync_secret in server.cfg and be reachable from
# wherever this bot runs (same host as FXServer, by default).
FXSERVER_SYNC_URL=http://127.0.0.1:30120/sfos/discord/permissions-sync
FXSERVER_SYNC_SECRET=change-me

# Shared secret for FXServer's /log HTTP endpoint when its audit log is
# enabled. Must match sfos_discord_log_secret in server.cfg.
FXSERVER_LOG_SECRET=change-me

# Shared secret for direct website recruitment notifications. Set this to
# the same value as the website's DISCORD_BOT_WEBHOOK_SECRET. If blank, the
# bot falls back to FXSERVER_LOG_SECRET.
DISCORD_RECRUITMENT_SECRET=

# Optional Discord role IDs assigned to accepted applicants by department.
DISCORD_ROLE_LEO=
DISCORD_ROLE_SAFD=
DISCORD_ROLE_SAEMS=

# Port this bot listens on for FXServer audit logs (/log) and website
# recruitment notifications (/recruitment/:event).
BOT_HTTP_PORT=30121
