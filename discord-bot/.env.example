# Verbose console logging (role sync decisions, command invocations, log
# server activity, status board polling). Off by default, restart to change -
# matches the Lua side's sfos_debug convention.
DEBUG=false

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional - leave blank to skip the audit log feature entirely. Website
# recruitment events (application submitted/accepted/rejected) pushed by
# portal-api also post to THIS channel.
DISCORD_LOG_CHANNEL_ID=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sfos
DB_PASSWORD=
DB_NAME=sfos

# Must match sfos_discord_sync_secret in server.cfg and be reachable from
# wherever this bot runs (same host as FXServer, by default).
FXSERVER_SYNC_URL=http://127.0.0.1:30120/sfos/discord/permissions-sync
FXSERVER_SYNC_SECRET=change-me

# Shared secret for the /log HTTP endpoint. Needed if DISCORD_LOG_CHANNEL_ID
# is set. Must match BOTH sfos_discord_log_secret in server.cfg AND
# portal-api's DISCORD_LOG_SECRET (portal-api posts website application
# events to /log using it).
FXSERVER_LOG_SECRET=change-me

# Port this bot listens on for FXServer's audit log posts
# (sfos_discord_log_url in server.cfg must point at
# http://<this-host>:<port>/log). The website no longer posts here -
# portal-api used to relay application-submitted/accepted/rejected events to
# this endpoint; that relay was retired along with portal-api and hasn't
# been rebuilt, so those three events no longer reach Discord automatically.
BOT_HTTP_PORT=30121

# --- Website: live on-duty status board (optional) ---
# Leave DISCORD_STATUS_CHANNEL_ID blank to skip. When both are set, the bot
# polls the web app's PUBLIC GET /api/status and keeps a single message in
# this channel up to date (no secret needed - it's a public route).
DISCORD_STATUS_CHANNEL_ID=
WEB_BASE_URL=http://127.0.0.1:3000
STATUS_POLL_SECONDS=60
